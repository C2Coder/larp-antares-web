{{!--
  One gallery photo - clicking it opens the viewer ({{> lightbox }}).
  Slideshow order = markup order, no indices are set anywhere.

  Usage:  {{> photo src="/assets/home/1.webp" alt="Tábor Antares 1" class="aspect-3/2" }}
          {{#each galleries.home}}{{> photo src=src alt=alt class="aspect-3/2"}}{{/each}}

  class    - classes for the button (aspect ratio, col-span, ...)
  imgClass - extra classes for the <img> itself
--}}
<button type="button" class="gallery-item {{class}}" aria-label="Otevřít fotku – {{alt}}">
  <img src="{{src}}" alt="{{alt}}" class="w-full h-full object-cover {{imgClass}}" loading="lazy" decoding="async">
</button>
