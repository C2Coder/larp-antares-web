{{!--  Usage:  {{> footer }}  --}}
<footer class="bg-text text-white pt-4 md:pt-12 pb-4">
  <div class="mx-auto px-2 md:px-8">
    <div class="flex flex-col items-center gap-4">
      <div class="flex items-center gap-2 md:gap-4">
        <a href="{{organizers.duha.url}}" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/duha-2d.jpg" alt="Logo DUHA 2D" class="h-12 md:h-20 rounded w-auto opacity-85 hover:opacity-100 transition-opacity"></a>
        <a href="{{organizers.khk.url}}" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/khk.jpg" alt="Logo KHK" class="h-12 md:h-20 rounded w-auto opacity-85 hover:opacity-100 transition-opacity"></a>
        <a href="{{organizers.msmt.url}}" target="_blank" rel="noopener noreferrer"><img src="/assets/logos/msmt.jpg" alt="Logo MŠMT" class="h-12 md:h-20 rounded w-auto opacity-85 hover:opacity-100 transition-opacity"></a>
      </div>
      <p class="text-white/60 text-sm text-center leading-relaxed max-w-xl">
        Tábor je pořádán pod hlavičkou organizace <a href="{{organizers.duha.url}}" target="_blank" rel="noopener" class="text-white/80 hover:text-white">{{organizers.duha.name}}</a>.
        Vznikl s podporou <a href="{{organizers.khk.url}}" target="_blank" rel="noopener" class="text-white/80 hover:text-white">{{organizers.khk.name}}</a>
        a <a href="{{organizers.msmt.url}}" target="_blank" rel="noopener" class="text-white/80 hover:text-white">{{organizers.msmt.name}}</a>.
      </p>
      <p class="text-white/70 text-sm">
        Made with ❤️ by <a href="https://github.com/C2Coder" class="text-primary hover:underline">C2Coder</a>
      </p>
    </div>
  </div>
</footer>
